{
  "name": "@jscorlib-repo/gh-pages-hosting",
  "version": "0.0.1",
  "description": "building scripts for GitHub Pages",
  "repository": "https://github.com/CXuesong/jscorlib.git",
  "author": "CXuesong",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "pwsh -File ./scripts/build.ps1",
    "build:collect-resources": "pwsh -File ./scripts/build.ps1 -CollectResources",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./src/tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "carbon-components-svelte": "^0.111.1",
    "carbon-icons-svelte": "^13.15.0",
    "sass": "^1.104.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vite-tsconfig-paths": "^6.1.1"
  }
}

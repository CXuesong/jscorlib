{
  "name": "@jscorlib-repo/gh-pages-hosting",
  "version": "0.0.1",
  "description": "building scripts for GitHub Pages",
  "repository": "https://github.com/CXuesong/jscorlib.git",
  "author": "CXuesong",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "pwsh -File ./scripts/build.ps1",
    "build:collect-resources": "pwsh -File ./scripts/build.ps1 -CollectResources",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./src/tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "carbon-components-svelte": "^0.94.0",
    "carbon-icons-svelte": "^13.6.0",
    "sass": "^1.94.2",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-checker": "^0.11.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}

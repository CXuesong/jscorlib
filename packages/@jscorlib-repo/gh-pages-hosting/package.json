{
  "name": "@jscorlib-repo/gh-pages-hosting",
  "version": "0.0.1",
  "description": "building scripts for GitHub Pages",
  "repository": "https://github.com/CXuesong/jscorlib.git",
  "author": "CXuesong",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "pwsh -File ./scripts/build.ps1",
    "build:collect-resources": "pwsh -File ./scripts/build.ps1 -CollectResources",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./src/tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "carbon-components-svelte": "^0.89.0",
    "carbon-icons-svelte": "^13.3.0",
    "sass": "^1.86.3",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-checker": "^0.9.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}

{
  // Base config; also for VSCode
  // https://github.com/Microsoft/vscode/issues/12463
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": [
      // Avoid triple-slash directives in emitted typedef files.
      // It will pollute the caller's globals (e.g., setTimeout signatures)
      "node"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "outDir": "../lib",
    "importHelpers": true,
  },
  "include": [
    "**/*.ts",
  ],
}